      "mode": "row-based"
    },
    "columnName": "dc.creator",
    "expression": "grel:with(filter(cells[\"Authors\"].value.split(\"; \"), v, or(v.contains(\"[Editor]\"), v.contains(\"[Compiler]\"))), a, if(a.length() > 0, a[0].replace(/\\s*\\[.*\\]$/, \"\"), \"\"))",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Text transform on cells in column dc.creator using expression grel:with(filter(cells[\"Authors\"].value.split(\"; \"), v, or(v.contains(\"[Editor]\"), v.contains(\"[Compiler]\"))), a, if(a.length() > 0, a[0].replace(/\\s*\\[.*\\]$/, \"\"), \"\"))"
  },
